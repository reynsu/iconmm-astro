---
import { withBase } from "@/lib/url";
import "@/styles/global.css";
import Scrollbar from "@/components/Scrollbar";
import { optimized } from "@/lib/images";
// URL con hash de la fuente del titular, para precargarla: el titular es el LCP y así no espera al CSS.
import interTight from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ICON Multimedia — Fabricantes de software de Digital Signage",
  description = "DENEVA, DENEVA.transit, MIRANDDA y KOMMANDA: software de digital signage, información al viajero, smart mirror y kioscos de autoservicio.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL((await optimized("/images/transit.jpg", { widths: [1200] })).src, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" type="image/png" href={withBase("/images/icon.png")} />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Scrollbar client:load />
  </body>
</html>
