---
import "@/styles/global.css";
import Scrollbar from "@/components/Scrollbar";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ICON Multimedia — Fabricantes de software de Digital Signage",
  description = "DENEVA, DENEVA.transit, MIRANDDA y KOMMANDA: software de digital signage, información al viajero, smart mirror y kioscos de autoservicio.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <link rel="preload" href="/data/dancer.bin" as="fetch" crossorigin="anonymous" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/transit.jpg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Scrollbar client:load />
  </body>
</html>
