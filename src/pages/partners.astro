---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader";
import PageHero from "@/components/PageHero.astro";
import PartnerBenefits from "@/components/PartnerBenefits";
import PartnerJourney from "@/components/PartnerJourney";
import PartnerCta from "@/components/PartnerCta";
import ContactForm from "@/components/ContactForm";
import Footer from "@/components/Footer.astro";
import { partners } from "@/data/pages";
---

<Layout
  title="Programa de partners — ICON Multimedia"
  description="Conviértete en partner de ICON Multimedia: certificaciones DENEVA, formación paso a paso y soporte 24/7/365 para tus proyectos de cartelería digital."
>
  <SiteHeader client:load />

  <main>
    <PageHero index="P" eyebrow={partners.eyebrow} lead={partners.intro}>
      Nuestro programa de <em class="font-serif font-normal tracking-normal text-ink/70 italic">partners</em>
    </PageHero>

    <!-- Por qué asociarse -->
    <section class="relative isolate bg-ink py-24 md:py-32">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(244_241_234/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(244_241_234/0.04)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
      >
      </div>
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <header class="max-w-3xl">
          <p class="eyebrow flex items-center gap-3 text-paper/50"><span class="text-signal-paper">[01]</span> Trabajando juntos</p>
          <h2 class="mt-5 text-4xl leading-[1.04] font-semibold tracking-[-0.035em] text-balance text-paper md:text-6xl">
            ¿Por qué asociarse con <em class="font-serif font-normal tracking-normal text-paper/80 italic">ICON Multimedia</em>?
          </h2>
        </header>
        <div class="mt-14">
          <PartnerBenefits client:visible />
        </div>
      </div>
    </section>

    <!-- Recorrido -->
    <section class="py-24 md:py-32">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <header class="max-w-3xl">
          <p class="eyebrow flex items-center gap-3"><span class="text-signal-ink">[02]</span> El recorrido</p>
          <h2 class="mt-5 text-4xl leading-[1.04] font-semibold tracking-[-0.035em] text-balance text-ink md:text-6xl">
            De la primera conversación <em class="font-serif font-normal tracking-normal text-ink/70 italic">al mercado</em>.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-pretty text-muted md:text-lg">
            Cuatro pasos, con un equipo dedicado al canal en cada uno de ellos.
          </p>
        </header>
        <PartnerJourney client:visible />
      </div>
    </section>

    <!-- CTA -->
    <section class="border-y border-line bg-paper-2/70 py-24 md:py-32">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <PartnerCta client:visible />
      </div>
    </section>

    <!-- Formulario -->
    <section id="hablamos" class="py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 md:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <header>
          <p class="eyebrow flex items-center gap-3"><span class="text-signal-ink">[03]</span> Contacto</p>
          <h2 class="mt-5 text-4xl leading-[1.04] font-semibold tracking-[-0.035em] text-balance text-ink md:text-6xl">
            ¿Hablamos?
          </h2>
          <p class="mt-6 max-w-md text-base leading-relaxed text-pretty text-muted md:text-lg">
            Déjanos tus datos y el equipo de canal se pondrá en contacto contigo.
          </p>
        </header>
        <ContactForm client:visible variant="partners" />
      </div>
    </section>
  </main>

  <Footer cta={false} />
</Layout>
