---
import { withBase } from "@/lib/url";
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader";
import Hero from "@/components/Hero";
import InnoTransCard from "@/components/InnoTransCard";
import Solutions from "@/components/Solutions";
import Clients from "@/components/Clients";
import News from "@/components/News";
import Footer from "@/components/Footer.astro";
import Presence from "@/components/Presence";
import { clients, event, news, solutions } from "@/data/site";
import { optimized, optimizedMap } from "@/lib/images";

// Las islas React no pueden usar astro:assets: las variantes se generan aquí y viajan como props.
// Calidad 40: son fotos de ambiente dentro de tarjetas; a ese tamaño no se nota y pesan un 25-35 % menos que a 70.
const solutionImages = await optimizedMap(solutions.map((s) => s.image), { sizes: "(min-width: 768px) 44vw, 92vw", quality: 40 });
const eventImage = await optimized(event.image, { sizes: "(min-width: 768px) 40vw, 90vw" });
const clientLogos = await optimizedMap(clients.map((c) => c.src));
const newsImages = await optimizedMap(news.map((n) => n.image), { widths: [480, 768], sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" });
---

<Layout>
  <SiteHeader client:load />

  <main>
    <!-- 1 · HERO: bailarina de papel + "Enabling a smart future" -->
    <section class="relative isolate overflow-hidden">
      <div aria-hidden="true" class="grain pointer-events-none absolute inset-0 -z-10 opacity-[0.35] mix-blend-multiply"></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-0 right-0 -z-10 h-[640px] w-[640px] translate-x-1/3 -translate-y-1/3 rounded-full bg-signal/[0.12] blur-[140px]"
      >
      </div>
      <Hero client:load />

      <!-- Tarjeta InnoTrans (en el original va bajo el titular) -->
      <div class="mx-auto max-w-7xl px-4 pb-12 md:px-8 md:pb-20">
        <InnoTransCard client:visible image={eventImage} />
      </div>
    </section>

    <!-- 2 · SOLUCIONES (banda oscura) -->
    <section id="soluciones" class="relative isolate bg-ink py-24 md:py-32">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(244_241_234/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(244_241_234/0.04)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
      >
      </div>
      <Solutions client:visible images={solutionImages} />
    </section>

    <!-- 3 · CLIENTES -->
    <section id="clientes" aria-labelledby="clientes-title" class="border-b border-line bg-paper-2/70 py-20 md:py-24">
      <div class="mx-auto mb-10 max-w-7xl px-4 md:px-8">
        <p class="eyebrow"><span class="text-signal-ink">[02]</span> Clientes</p>
        <h2 id="clientes-title" class="mt-4 text-3xl font-semibold tracking-[-0.03em] text-balance text-ink md:text-5xl">
          Ellos ya <em class="font-serif font-normal tracking-normal text-ink/70 italic">confían</em> en nosotros
        </h2>
      </div>
      <Clients client:visible images={clientLogos} />
    </section>

    <!-- 4 · PRESENCIA INTERNACIONAL: globo que se convierte en mapa al hacer scroll -->
    <section id="presencia" aria-label="Presencia internacional" class="border-t border-line" style="min-height: 100vh">
      <Presence client:only="react" />
    </section>

    <!-- 5 · NOTICIAS -->
    <section id="noticias" class="border-t border-line py-24 md:py-32">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="max-w-3xl">
            <p class="eyebrow"><span class="text-signal-ink">[04]</span> Noticias</p>
            <h2 class="mt-5 text-4xl leading-[1.02] font-semibold tracking-[-0.035em] text-balance text-ink md:text-6xl">
              Últimas <em class="font-serif font-normal tracking-normal text-ink/70 italic">noticias</em>
            </h2>
          </div>
          <a href={withBase("/noticias")} class="shrink-0 text-sm font-medium text-ink/70 transition hover:text-signal"
            >Ver todas las noticias →</a
          >
        </div>
        <div class="mt-12">
          <News client:visible images={newsImages} />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
