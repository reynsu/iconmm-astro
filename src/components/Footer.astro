---
import { Logo } from "@/components/Logo";
import FooterCta from "@/components/FooterCta";
import SocialDock from "@/components/SocialDock";
import BigIcon from "@/components/BigIcon";
import { icex, legal, members, nav, offices, solutions } from "@/data/site";

interface Props {
  /** Bloque "¿Hablamos de tu próxima pantalla?" sobre el pie. Se oculta en páginas con su propio formulario o cierre. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
---

<footer id="contacto" class="relative overflow-hidden bg-ink text-paper">
  {cta && <FooterCta client:visible />}

  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class:list={["grid gap-12 pt-16", cta && "border-t border-line-dark"]} lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
      <div>
        <Logo inverted />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-paper/55">
          ICON Multimedia, S.L. Fabricantes de software de digital signage, información al viajero, smart mirror y
          kioscos de autoservicio.
        </p>
        <div class="mt-8">
          <SocialDock client:visible />
        </div>
      </div>

      <nav aria-label="Soluciones">
        <p class="eyebrow text-paper/45">Soluciones</p>
        <ul class="mt-5 space-y-3 text-sm">
          {
            solutions.map((item) => (
              <li>
                <a href={item.link} class="text-paper/80 transition hover:text-signal">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Empresa">
        <p class="eyebrow text-paper/45">Empresa</p>
        <ul class="mt-5 space-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.link} class="text-paper/80 transition hover:text-signal">
                  {item.name}
                </a>
              </li>
            ))
          }
          <li><a href="/contacto" class="text-paper/80 transition hover:text-signal">Contacto</a></li>
          <li><a href="https://www.iconmm.com/about-us/" class="text-paper/80 transition hover:text-signal">Conócenos</a></li>
        </ul>
      </nav>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
        {
          offices.map((office) => (
            <address class="rounded-2xl border border-line-dark bg-paper/[0.03] p-5 text-sm not-italic">
              <p class="eyebrow text-signal">Oficina {office.region}</p>
              <p class="mt-3 font-medium text-paper">{office.city}</p>
              <p class="mt-1 leading-relaxed text-paper/55">
                {office.address.map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))}
              </p>
              <a href={`tel:${office.phone.replace(/\s/g, "")}`} class="mt-3 inline-block font-mono text-paper/80 hover:text-signal">
                {office.phone}
              </a>
            </address>
          ))
        }
      </div>
    </div>

    <div class="mt-16 border-t border-line-dark pt-10">
      <p class="eyebrow text-paper/45">Somos miembros de</p>
      <ul class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-6" aria-label="Asociaciones">
        {
          members.map((m) => (
            <li>
              <img src={m.src} alt={m.name} loading="lazy" class="h-7 w-auto opacity-50 brightness-0 invert transition hover:opacity-90" />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10 flex flex-col gap-5 rounded-2xl border border-line-dark bg-paper/[0.03] p-5 lg:flex-row lg:items-center lg:gap-8">
      <p class="text-xs leading-relaxed text-paper/50 lg:flex-1">{icex.text}</p>
      <ul class="flex shrink-0 flex-wrap items-center gap-3" aria-label="Logotipos y certificaciones">
        {
          icex.logos.map((logo) => (
            <li class="rounded-lg bg-white px-3 py-2">
              <img src={logo.src} alt={logo.name} loading="lazy" class="h-6 w-auto" />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-6 flex flex-col gap-4 border-t border-line-dark py-8 text-xs text-paper/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} ICON Multimedia, S.L. Todos los derechos reservados.</p>
      <ul class="flex flex-wrap gap-6">
        {legal.map((item) => <li><a href={item.href} class="hover:text-paper">{item.name}</a></li>)}
      </ul>
    </div>
  </div>

  <BigIcon client:visible />
</footer>
