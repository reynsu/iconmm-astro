---
interface Props {
  index: string;
  label: string;
  align?: "left" | "center";
  class?: string;
}

const { index, label, align = "left", class: className } = Astro.props;
const centered = align === "center";
---

<header class:list={["max-w-3xl", centered && "mx-auto text-center", className]}>
  <p class:list={["eyebrow flex items-center gap-3", centered && "justify-center"]}>
    <span class="text-signal">[{index}]</span>
    <span>{label}</span>
  </p>
  <h2 class="mt-5 text-4xl leading-[1.02] font-semibold tracking-[-0.035em] text-balance text-fg md:text-6xl">
    <slot />
  </h2>
  {
    Astro.slots.has("lead") && (
      <p class:list={["mt-6 max-w-xl text-base leading-relaxed text-pretty text-muted md:text-lg", centered && "mx-auto"]}>
        <slot name="lead" />
      </p>
    )
  }
</header>
