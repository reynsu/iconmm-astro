---
import { TextGenerateEffect } from "@/components/ui/text-generate-effect";

interface Props {
  index: string;
  eyebrow: string;
  lead?: string;
  class?: string;
}

const { index, eyebrow, lead, class: className } = Astro.props;
---

<section class:list={["relative isolate overflow-hidden pt-36 pb-16 md:pt-44 md:pb-24", className]}>
  <div aria-hidden="true" class="grain pointer-events-none absolute inset-0 -z-10 opacity-[0.35] mix-blend-multiply"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 right-0 -z-10 h-[560px] w-[560px] translate-x-1/3 -translate-y-1/2 rounded-full bg-signal/[0.12] blur-[140px]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle,rgb(20_20_24/0.16)_1px,transparent_1px)] bg-[size:18px_18px] [mask-image:radial-gradient(ellipse_60%_55%_at_30%_30%,black,transparent)]"
  >
  </div>
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <p class="eyebrow flex items-center gap-3">
      <span class="text-signal">[{index}]</span> {eyebrow}
    </p>
    <h1 class="mt-6 max-w-4xl text-[clamp(2.6rem,6.5vw,5.5rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance text-ink">
      <slot />
    </h1>
    {
      lead && (
        <TextGenerateEffect
          client:load
          words={lead}
          duration={0.6}
          className="mt-8 max-w-2xl text-lg leading-relaxed text-pretty text-muted md:text-xl"
        />
      )
    }
    <slot name="after" />
  </div>
</section>
